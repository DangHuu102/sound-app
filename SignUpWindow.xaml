<Window x:Class="soundapp.SignUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Studio — Sign Up" Height="680" Width="900"
        Background="#0B0914" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#8783a2"/>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Background" Value="#1A1530"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2e2a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7B2FBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PwdBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1A1530"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2e2a4a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7B2FBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0B0914" CornerRadius="12" BorderBrush="#1e1a35" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5D26C1" Offset="0"/>
                                <GradientStop Color="#9B4DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="♫" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sound Studio" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Feel the Difference" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Sign up" Foreground="White" BorderThickness="0" Padding="20,8"
                            FontSize="14" Cursor="Hand">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#7B2FBE" Offset="0"/>
                                <GradientStop Color="#9B4DFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="20"/></Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Divider -->
            <Border Grid.Row="1" Background="#1e1a35"/>

            <!-- Main Content -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <!-- Icon -->
                <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2a1f4a" Offset="0"/>
                            <GradientStop Color="#3d2070" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="♪" FontSize="26" Foreground="#9B4DFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Create your account" Foreground="White" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Start listening for free." Foreground="{StaticResource TextMuted}"
                           FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <!-- Display Name -->
                <TextBox x:Name="NameBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"
                         Tag="Display name" GotFocus="ClearPlaceholder" LostFocus="RestorePlaceholder"/>

                <!-- Email -->
                <TextBox x:Name="EmailBox" Style="{StaticResource InputBox}" Margin="0,0,0,12"
                         Tag="Email address" GotFocus="ClearPlaceholder" LostFocus="RestorePlaceholder"/>

                <!-- Password -->
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PwdBox}" Margin="0,0,0,20"/>

                <!-- Error -->
                <TextBlock x:Name="ErrorText" Foreground="#ff5555" FontSize="13"
                           HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,10"/>

                <!-- Sign Up Button -->
                <Button x:Name="SignUpBtn" Height="48" Click="SignUpBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="10">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7B2FBE" Offset="0"/>
                                        <GradientStop Color="#9B4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="Create account" Foreground="White" FontSize="15"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Login link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="Already have an account? " Foreground="{StaticResource TextMuted}" FontSize="13"/>
                    <Button Content="Log in" Background="Transparent" BorderThickness="0"
                            Foreground="#9B4DFF" FontSize="13" FontWeight="Bold"
                            Cursor="Hand" Click="LoginLink_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="3" Text="UI concept · Dark mode · Violet accents"
                       Foreground="#3a3550" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
