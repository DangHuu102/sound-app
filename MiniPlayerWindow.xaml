<Window x:Class="soundapp.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Player" Height="300" Width="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="15"/>
    </WindowChrome.WindowChrome>

    <Border Background="#161324" CornerRadius="15" BorderBrush="#25213b" BorderThickness="1" Margin="5"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Thumbnail -->
            <Border CornerRadius="10" Background="#25213b" Margin="0,0,0,10" ClipToBounds="True">
                <Image x:Name="ThumbnailImage" Stretch="UniformToFill"/>
            </Border>

            <!-- Marquee Title -->
            <Grid Grid.Row="1" Height="30" ClipToBounds="True" Margin="0,0,0,4">
                <TextBlock x:Name="TitleText"
                           Foreground="White" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="MarqueeTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>

            <!-- Artist Row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <TextBlock Text="✦" Foreground="#59C173" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ArtistText" Text="Sound Studio" Foreground="#8783a2" FontSize="12" VerticalAlignment="Center"/>

                <!-- Nút điều khiển góc phải -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="auto,0,0,0">
                    <Button Content="—" Width="26" Height="22" Background="Transparent" Foreground="#8783a2"
                            BorderThickness="0" Cursor="Hand" Click="MinimizeButton_Click" FontSize="12"/>
                    <Button Content="⤢" Width="26" Height="22" Background="Transparent" Foreground="#8783a2"
                            BorderThickness="0" Cursor="Hand" Click="RestoreButton_Click" FontSize="12"/>
                    <Button Content="✕" Width="26" Height="22" Background="Transparent" Foreground="#ff5555"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
