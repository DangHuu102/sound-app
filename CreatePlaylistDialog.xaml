<Window x:Class="soundapp.CreatePlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Playlist" Height="200" Width="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border Background="#161324" CornerRadius="12" BorderBrush="#25213b" BorderThickness="1" Margin="5">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="3" Opacity="0.6"/>
        </Border.Effect>
        <StackPanel Margin="24">
            <TextBlock Text="New Playlist" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBox x:Name="NameBox" Background="#1A1530" Foreground="White" BorderBrush="#2e2a4a"
                     BorderThickness="1" Padding="12,10" FontSize="14" CaretBrush="White"
                     Margin="0,0,0,16">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,10,0"
                        Background="Transparent" Foreground="#8783a2" BorderThickness="1"
                        BorderBrush="#2e2a4a" Padding="16,8" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="Create" Click="Create_Click" Foreground="White"
                        BorderThickness="0" Padding="16,8" Cursor="Hand">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#7B2FBE" Offset="0"/>
                            <GradientStop Color="#9B4DFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
