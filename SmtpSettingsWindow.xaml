<Window x:Class="soundapp.SmtpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt Email" Height="580" Width="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#180A33" Offset="0"/>
            <GradientStop Color="#06020c" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Border Background="#0Dffffff" BorderBrush="#1Affffff" BorderThickness="1" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="8" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="36,28">

            <!-- Title -->
            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="⚙  Cài đặt Email OTP" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Làm theo 3 bước bên dưới là xong!" Foreground="#9B4DFF" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Foreground="#8783a2" FontSize="16" Cursor="Hand"/>
            </Grid>

            <!-- STEP 1 -->
            <Border Background="#12ffffff" BorderBrush="#2e2a4a" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#9B4DFF" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Mở trang tạo App Password" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Đăng nhập Gmail → chọn Mail → Windows Computer → Generate" 
                                   Foreground="#8783a2" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" Click="OpenGoogleBtn_Click" Margin="10,0,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Padding="14,8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#7B2FBE" Offset="0"/>
                                            <GradientStop Color="#9B4DFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="Mở ↗" Foreground="White" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- STEP 2 -->
            <Border Background="#12ffffff" BorderBrush="#2e2a4a" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#7B2FBE" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Nhập địa chỉ Gmail của bạn" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Gmail bạn dùng để tạo App Password ở bước 1"
                                   Foreground="#8783a2" FontSize="11" Margin="0,3,0,8"/>
                        <Border Background="#1Affffff" BorderBrush="#3Affffff" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <TextBox x:Name="GmailBox" Background="Transparent" Foreground="White"
                                         BorderThickness="0" Padding="38,10,12,10" FontSize="13" CaretBrush="White"/>
                                <TextBlock Text="✉" Foreground="#8783a2" FontSize="14" Margin="13,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STEP 3 -->
            <Border Background="#12ffffff" BorderBrush="#2e2a4a" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#5B1F9E" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Dán App Password (16 ký tự) vào đây" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Google sẽ hiện mã dạng: xxxx xxxx xxxx xxxx"
                                   Foreground="#8783a2" FontSize="11" Margin="0,3,0,8"/>
                        <Border Background="#1Affffff" BorderBrush="#3Affffff" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <PasswordBox x:Name="AppPwdBox" Background="Transparent" Foreground="White"
                                             BorderThickness="0" Padding="38,10,12,10" FontSize="14"/>
                                <TextBlock Text="🔑" Foreground="#8783a2" FontSize="13" Margin="13,0,0,0"
                                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"
                       Visibility="Collapsed" Margin="0,0,0,12"/>

            <!-- Save / Clear Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="ClearBtn_Click" ToolTip="Xóa credentials đã lưu">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="#3a2a4a" BorderThickness="1"
                                    CornerRadius="8" Padding="16,12">
                                <TextBlock Text="🗑 Xóa" Foreground="#8783a2" FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Click="SaveBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Padding="28,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7B2FBE" Offset="0"/>
                                        <GradientStop Color="#9B4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="💾  Lưu và kích hoạt" Foreground="White"
                                           FontSize="13" FontWeight="Bold"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

        </StackPanel>
    </Border>
</Window>
