<Window x:Class="soundapp.SmtpSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt Email — Sound Studio" Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#180A33" Offset="0"/>
            <GradientStop Color="#06020c" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Border Background="#0Bffffff" BorderBrush="#1Affffff" BorderThickness="1" CornerRadius="16" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="8" Opacity="0.5"/>
        </Border.Effect>
        <StackPanel Margin="35,30">
            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚙ Cài đặt Email" Foreground="White" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Credentials được mã hóa bởi Windows (DPAPI)" Foreground="#9B4DFF" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Foreground="#8783a2" FontSize="16" Cursor="Hand"/>
            </Grid>

            <!-- Info box -->
            <Border Background="#1A9B4DFF" BorderBrush="#9B4DFF" BorderThickness="1" CornerRadius="8" Padding="15,12" Margin="0,0,0,20">
                <TextBlock TextWrapping="Wrap" Foreground="#c4a8ff" FontSize="12" LineHeight="20">
                    <Run FontWeight="Bold">🔒 Bảo mật:</Run>
                    <Run> Gmail App Password được lưu trong Windows Credential Manager, mã hóa DPAPI. Không lưu trong source code hay file config.</Run>
                </TextBlock>
            </Border>

            <!-- Gmail Address -->
            <TextBlock Text="Gmail gửi mail (tài khoản của app)" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <Border Background="#1Affffff" BorderBrush="#2Affffff" BorderThickness="1" CornerRadius="8" Margin="0,0,0,16">
                <Grid>
                    <TextBox x:Name="GmailBox" Background="Transparent" Foreground="White"
                             BorderThickness="0" Padding="42,12,12,12" FontSize="13" CaretBrush="White"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="✉" Foreground="#8783a2" FontSize="15" Margin="15,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- App Password -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="Gmail App Password (16 ký tự)" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11">
                    <Hyperlink NavigateUri="https://myaccount.google.com/apppasswords"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Foreground="#9B4DFF">Tạo App Password ↗</Run>
                    </Hyperlink>
                </TextBlock>
            </Grid>
            <Border Background="#1Affffff" BorderBrush="#2Affffff" BorderThickness="1" CornerRadius="8" Margin="0,0,0,25">
                <Grid>
                    <PasswordBox x:Name="AppPwdBox" Background="Transparent" Foreground="White"
                                 BorderThickness="0" Padding="42,12,12,12" FontSize="13"/>
                    <TextBlock Text="🔑" Foreground="#8783a2" FontSize="14" Margin="15,0,0,0"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Status -->
            <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Center"
                       Visibility="Collapsed" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="🗑 Xóa credentials" Click="ClearBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="#4a3a6a" BorderThickness="1"
                                    CornerRadius="8" Padding="0,12">
                                <TextBlock Text="🗑 Xóa credentials" Foreground="#8783a2"
                                           FontSize="13" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="💾 Lưu" Click="SaveBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Padding="0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7B2FBE" Offset="0"/>
                                        <GradientStop Color="#9B4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="💾 Lưu" Foreground="White"
                                           FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
