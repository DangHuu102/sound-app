<Window x:Class="soundapp.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Studio — Login" Height="650" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize">

    <Window.Background>
        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#180A33" Offset="0"/>
            <GradientStop Color="#06020c" Offset="1"/>
        </RadialGradientBrush>
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#8783a2"/>
        <!-- Glass Textbox -->
        <Style x:Key="GlassInput" TargetType="TextBox">
            <Setter Property="Background" Value="#1Affffff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2Affffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="45,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#9B4DFF"/>
                                <Setter Property="Background" Value="#2Affffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Glass PasswordBox -->
        <Style x:Key="GlassPwd" TargetType="PasswordBox">
            <Setter Property="Background" Value="#1Affffff"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2Affffff"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="45,0,35,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#9B4DFF"/>
                                <Setter Property="Background" Value="#2Affffff"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Top Left Back Button & Logo -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="20">
            <Button Click="Back_Click" Width="36" Height="36" Cursor="Hand" Margin="0,0,15,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" BorderBrush="#2Affffff" BorderThickness="1" CornerRadius="18" Width="36" Height="36">
                            <TextBlock Text="←" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock Text="||| Sound Studio" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Window Controls -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="20">
            <Button Content="✕" Click="Close_Click" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" 
                    Width="30" Height="30" Cursor="Hand" FontSize="14"/>
        </StackPanel>

        <!-- Center Glass Card -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" 
                Background="#0Bffffff" BorderBrush="#1Affffff" BorderThickness="1" CornerRadius="16" Padding="40">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="10" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel>
                <!-- Logo -->
                <TextBlock Text="|||" Foreground="#9B4DFF" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Sound Studio" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Feel the Difference" Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Username or Email -->
                <TextBlock Text="Username or Email" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,16">
                    <TextBox x:Name="EmailBox" Style="{StaticResource GlassInput}" 
                             Tag="Enter your username or email" GotFocus="ClearPlaceholder" LostFocus="RestorePlaceholder" Height="43" VerticalAlignment="Top" Margin="0,24,0,0"/>
                    <TextBlock Text="👤" Foreground="#8783a2" FontSize="14" Margin="10,36,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>

                <!-- Password -->
                <TextBlock Text="Password" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource GlassPwd}" Height="46" VerticalAlignment="Top"/>
                    <TextBlock Text="🔒" Foreground="#8783a2" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <Button Content="👁" Background="Transparent" BorderThickness="0" Foreground="#8783a2" 
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand"/>
                </Grid>

                <!-- Remember me & Forgot pwd -->
                <Grid Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="RememberMe" Content="Remember me" Foreground="#8783a2" FontSize="12" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Forgot password?" Foreground="#9B4DFF" Background="Transparent" BorderThickness="0" 
                            FontSize="12" HorizontalAlignment="Right" Cursor="Hand"/>
                </Grid>

                <TextBlock x:Name="ErrorText" Foreground="#ff5555" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,10"/>

                <!-- Log In Button -->
                <Button x:Name="LoginBtn" Click="LoginBtn_Click" Height="44" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7B2FBE" Offset="0"/>
                                        <GradientStop Color="#9B4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="Log in" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Sign up link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock Text="Don't have an account? " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    <Button Content="Sign up" Background="Transparent" BorderThickness="0" Foreground="#9B4DFF" FontSize="12" Cursor="Hand" Click="SignUpLink_Click" RenderTransformOrigin="0.523,0.552" Height="35" Width="62"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
