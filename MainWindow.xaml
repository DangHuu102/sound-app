<Window x:Class="soundapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Click App" Height="800" Width="1000"
        Background="#0B0B14"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Colors and Gradients -->
        <LinearGradientBrush x:Key="NeonGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00f2fe" Offset="0.0"/>
            <GradientStop Color="#4facfe" Offset="0.5"/>
            <GradientStop Color="#f093fb" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CyanGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00f2fe" Offset="0.0"/>
            <GradientStop Color="#4facfe" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBg" Color="#151522"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#222236"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8B8B9E"/>

        <!-- Common Styles -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,20"/>
        </Style>

        <!-- Slider Template -->
        <Style x:Key="NeonSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" Background="#2A2A40" CornerRadius="3" VerticalAlignment="Center" Margin="8,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{StaticResource CyanGradient}" CornerRadius="3,0,0,3">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#00f2fe" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White" Stroke="#00f2fe" StrokeThickness="2">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#00f2fe" BlurRadius="10" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header Button -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="20" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#0D0D17" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,30,0,0">
                <!-- App Icon -->
                <Ellipse Width="40" Height="40" Stroke="{StaticResource NeonGradient}" StrokeThickness="2" Margin="0,0,0,40">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#f093fb" BlurRadius="15" ShadowDepth="0"/>
                    </Ellipse.Effect>
                </Ellipse>
                
                <!-- Menu Icons (using Segoe UI Symbol) -->
                <TextBlock Text="&#xE115;" Style="{StaticResource IconText}" Foreground="#00f2fe">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#00f2fe" BlurRadius="10" ShadowDepth="0"/>
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="&#xE121;" Style="{StaticResource IconText}"/>
                <TextBlock Text="&#xE1D3;" Style="{StaticResource IconText}"/>
                <TextBlock Text="&#xE136;" Style="{StaticResource IconText}"/>
                <TextBlock Text="&#xE115;" Style="{StaticResource IconText}" Margin="0,200,0,0"/> <!-- Settings at bottom -->
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Text="SOUND CLICK APP" FontSize="22" FontWeight="Bold" Foreground="{StaticResource NeonGradient}" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="&#xE1A3; Browse File" FontFamily="Segoe UI Symbol" Style="{StaticResource HeaderBtn}" Margin="0,0,15,0" Click="BrowseButton_Click"/>
                    <Ellipse Width="40" Height="40" Fill="#2A2A40"/>
                </StackPanel>
            </Grid>

            <!-- PANEL 1: BPM / TEMPO -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="BPM / TEMPO CONTROL" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>

                    <!-- Circle and BPM Text -->
                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Outer Glow Ring -->
                        <Ellipse Width="220" Height="220" Stroke="{StaticResource CyanGradient}" StrokeThickness="4" StrokeDashArray="2 1">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00f2fe" BlurRadius="20" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <!-- Inner Ring -->
                        <Ellipse Width="180" Height="180" Stroke="#2A2A40" StrokeThickness="10"/>
                        <Ellipse Width="180" Height="180" Stroke="{StaticResource CyanGradient}" StrokeThickness="10" StrokeDashArray="4 8"/>
                        
                        <!-- Texts -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="KeyDisplay" Text="READY" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="CurrentFileText" Text="click.wav" FontSize="14" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Waveform Simulation -->
                    <StackPanel x:Name="WaveformPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Height="50" Opacity="0.5">
                        <Rectangle Width="6" Height="10" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="25" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="15" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="40" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="30" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="50" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="20" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="35" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="45" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="15" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="25" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="10" Fill="{StaticResource NeonGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANEL 2: VOLUME MIXER -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="VOLUME MIXER" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"/>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Slider 1 -->
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MASTER" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1" Value="1" ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock Grid.Column="2" Text="100%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <!-- Slider 2 -->
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CLICK" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1" Value="0.8"/>
                            <TextBlock Grid.Column="2" Text="80%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Slider 3 -->
                        <Grid Margin="0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AMBIENT" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1" Value="0.4"/>
                            <TextBlock Grid.Column="2" Text="40%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
