<Window x:Class="soundapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Studio" Height="750" Width="1100"
        Background="#0B0914"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Colors and Gradients -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5D26C1" Offset="0.0"/>
            <GradientStop Color="#a17fe0" Offset="0.5"/>
            <GradientStop Color="#59C173" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7F00FF" Offset="0.0"/>
            <GradientStop Color="#E100FF" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBg" Color="#161324"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#25213b"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8783a2"/>

        <!-- Common Styles -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#25213b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25" Width="50" Height="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Color="#7F00FF" BlurRadius="15" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" Background="#25213b" CornerRadius="3" VerticalAlignment="Center" Margin="8,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{StaticResource PurpleGradient}" CornerRadius="3,0,0,3">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#E100FF" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#E100FF" BlurRadius="10" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#180A33" Offset="0"/>
                <GradientStop Color="#06020c" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: SIDEBAR -->
        <Border Background="Transparent" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="20,40,20,0">
                <!-- App Menu (Home, Search, Library) -->
                <StackPanel Margin="0,0,0,40">
                    <Button Margin="0,0,0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#1Affffff" CornerRadius="8" Padding="15,10">
                                    <TextBlock Text="🏠  Home" Foreground="White" FontSize="13"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Margin="0,0,0,4">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="8" Padding="15,10">
                                    <TextBlock Text="🔍  Search" Foreground="#8783a2" FontSize="13"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" CornerRadius="8" Padding="15,10">
                                    <TextBlock Text="📚  Library" Foreground="#8783a2" FontSize="13"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                
                <!-- Play History -->
                <Grid Margin="0,10,0,10">
                    <TextBlock Text="Recent Tracks" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="Clear" Foreground="#8783a2" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="ClearHistoryBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline" Foreground="{TemplateBinding Foreground}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#ff5555"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Padding="10,8" CornerRadius="5" Background="Transparent" x:Name="ItemBorder">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#251b4d"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button Click="HistoryItem_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="🎵" Margin="0,0,12,0" Opacity="0.5" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" MaxWidth="150" Foreground="White" FontWeight="SemiBold"/>
                                        <TextBlock Text="Recent Track" FontSize="11" Opacity="0.6" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Playlist Section -->
                <Grid Margin="0,20,0,8">
                    <TextBlock Text="My Playlists" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Content="+ New" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="CreatePlaylistBtn_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="#251b4d" CornerRadius="5" Padding="8,3">
                                                <TextBlock Text="{TemplateBinding Content}" Foreground="#9B4DFF" FontSize="12"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Playlist List -->
                <ListBox x:Name="PlaylistList" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource TextMuted}" MaxHeight="120"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Padding="10,7" CornerRadius="5" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#251b4d"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☰" Margin="0,0,8,0" Opacity="0.5" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Mini Player Button -->
                <Button Margin="0,20,0,0" Height="36" Click="MiniPlayerBtn_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" BorderBrush="#2e2a4a" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1a1530" Offset="0"/>
                                        <GradientStop Color="#251b4d" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⧉" Foreground="#9B4DFF" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Mini Player" Foreground="White" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Settings Email Button -->
                <Button Margin="0,8,0,0" Click="EmailSettingsBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Padding="12,8" Background="Transparent" BorderBrush="#2e2a4a" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="⚙" Foreground="#8783a2" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Cài đặt Email" Foreground="#8783a2" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>

        <!-- COLUMN 2: CENTER PANEL -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Right Auth Buttons -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,10">
                <Button Click="SignUp_Click" Margin="0,0,10,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" BorderBrush="#4a3a6a" BorderThickness="1" CornerRadius="20" Padding="20,8">
                                <TextBlock Text="Sign up" Foreground="White" FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Click="Login_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="20" Padding="20,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#7B2FBE" Offset="0"/>
                                        <GradientStop Color="#9B4DFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="Log in" Foreground="White" FontSize="13"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Center Logo -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,40">
                <TextBlock Text="|||" Foreground="#9B4DFF" FontSize="42" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Sound Studio" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Feel the Difference" Foreground="#8783a2" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- YouTube Explorer Panel -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="10">
                <StackPanel Margin="20">
                    <TextBlock Text="Music Explorer (YouTube)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="YoutubeUrlTextBox" Background="#0B0914" Foreground="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="10" VerticalContentAlignment="Center" FontSize="14"/>
                        <Button Grid.Column="1" Content="LOAD AUDIO" Style="{StaticResource HeaderBtn}" Margin="15,0,0,0" Click="LoadYoutubeButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="YoutubeStatusText" Margin="0,10,0,0" Text="" Foreground="#E100FF" FontSize="12" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Output Volume Panel -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="10">
                <StackPanel Margin="20">
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="Output Volume" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="🔊 Điều chỉnh âm lượng Windows" FontSize="10" Foreground="#9B4DFF" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Master Volume -->
                    <Grid Margin="0,5,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="DeviceNameText" Text="Master Output" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="DeviceTypeText" Text="Windows Volume" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource NeonSlider}"
                                Minimum="0" Maximum="1" Value="1"
                                ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VolumePercentText" Grid.Column="2" Text="100%"
                                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <!-- Mute Button -->
                        <Button Grid.Column="3" x:Name="MuteBtn" Click="MuteBtn_Click"
                                ToolTip="Mute/Unmute" Margin="8,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Width="32" Height="32">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent" CornerRadius="6" Padding="4">
                                        <TextBlock x:Name="PART_Icon"
                                                   Text="&#xE767;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Foreground="#8783a2"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="PART_Icon" Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="muted">
                                            <Setter TargetName="PART_Icon" Property="Text" Value="&#xE74F;"/>
                                            <Setter TargetName="PART_Icon" Property="Foreground" Value="#ff5555"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- COLUMN 3: RIGHT PANEL (NOW PLAYING) -->
        <Grid Grid.Column="2" Margin="10,30,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Now Playing Card -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20">
                <StackPanel Margin="20">
                    <TextBlock Text="Now Playing" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <!-- Album Art Placeholder / Real Image -->
                    <Border Height="180" CornerRadius="10" Background="{StaticResource PrimaryGradient}" Margin="0,0,0,20" ClipToBounds="True">
                        <Grid>
                            <TextBlock Text="AUDIO" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                            <Image x:Name="NowPlayingImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    
                    <!-- Track Info -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CurrentFileText" Text="Ready to play" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Sound Studio App" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <!-- Mini Player Button -->
                        <Button Grid.Column="1" Content="&#xE1D6;" FontFamily="Segoe UI Symbol" Style="{StaticResource HeaderBtn}" Background="Transparent" ToolTip="Open Mini Player" Click="MiniPlayerBtn_Click" VerticalAlignment="Top" Padding="10,5"/>
                    </Grid>
                    
                    <!-- Controls -->
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Stop -->
                        <Button Grid.Column="1" Margin="0,0,15,0" Click="StopButton_Click" ToolTip="Stop" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#25213b" CornerRadius="10" Padding="14,10" x:Name="bg">
                                        <TextBlock Text="&#xE100;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#3a3155"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Play / Pause toggle -->
                        <Button Grid.Column="2" x:Name="PlayPauseBtn" Click="PlayButton_Click" ToolTip="Play / Pause" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Width="54" Height="54" CornerRadius="27" x:Name="bg">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#7F00FF" Offset="0"/>
                                                <GradientStop Color="#E100FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#7F00FF" BlurRadius="18" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <TextBlock x:Name="PlayIcon" Text="&#xE102;" FontFamily="Segoe UI Symbol"
                                                   FontSize="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="paused">
                                            <Setter TargetName="PlayIcon" Property="Text" Value="&#xE102;"/>
                                        </Trigger>
                                        <Trigger Property="Tag" Value="playing">
                                            <Setter TargetName="PlayIcon" Property="Text" Value="&#xE103;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Browse file -->
                        <Button Grid.Column="3" Margin="15,0,0,0" Click="BrowseButton_Click" ToolTip="Browse local file" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#25213b" CornerRadius="10" Padding="14,10" x:Name="bg">
                                        <TextBlock Text="&#xE142;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#3a3155"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Download file -->
                        <Button Grid.Column="4" Margin="15,0,0,0" Click="DownloadButton_Click" ToolTip="Download as MP3" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#25213b" CornerRadius="10" Padding="14,10" x:Name="bg">
                                        <TextBlock Text="&#xE118;" FontFamily="Segoe UI Symbol" FontSize="16"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#3a3155"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Download Progress -->
                    <Grid x:Name="DownloadProgressGrid" Visibility="Collapsed" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="DownloadProgressBar" Height="4" Background="#25213b" Foreground="#9B4DFF" BorderThickness="0" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="DownloadProgressText" Grid.Column="1" Text="0%" Foreground="#8783a2" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Up Next & Related Panel -->
                    <Grid Margin="0,20,0,0" VerticalAlignment="Stretch" MinHeight="150">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="Đợi phát (Queue)" Foreground="White" FontWeight="Bold" Margin="0,0,15,0" Cursor="Hand"/>
                            <TextBlock Text="Gợi ý tương tự" Foreground="#8783a2" Cursor="Hand"/>
                        </StackPanel>
                        
                        <ListBox x:Name="QueueList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Button Click="QueueItem_Click" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border Padding="5" Margin="0,0,0,5" CornerRadius="5" Background="#251b4d" x:Name="ItemBorder">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Image Source="{Binding ThumbnailUrl}" Width="40" Height="40" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                                                    <StackPanel VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Title}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="White"/>
                                                                        <TextBlock Text="{Binding ArtistName}" MaxWidth="180" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#8783a2"/>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#3a2a7a"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast Notification Overlay -->
        <Border x:Name="ToastNotification" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,20,0,0" Background="#231326" BorderBrush="#FF4D6D" BorderThickness="1.5"
                CornerRadius="10" Padding="16,8" Visibility="Collapsed" Panel.ZIndex="100">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" ShadowDepth="5" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Text="⚠️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastMessage" Text="" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
