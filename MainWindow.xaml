<Window x:Class="soundapp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sound Studio" Height="750" Width="1100"
        Background="#0B0914"
        WindowStartupLocation="CenterScreen"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- Colors and Gradients -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5D26C1" Offset="0.0"/>
            <GradientStop Color="#a17fe0" Offset="0.5"/>
            <GradientStop Color="#59C173" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7F00FF" Offset="0.0"/>
            <GradientStop Color="#E100FF" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="PanelBg" Color="#161324"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#25213b"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8783a2"/>

        <!-- Common Styles -->
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#25213b"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBtn" TargetType="Button" BasedOn="{StaticResource HeaderBtn}">
            <Setter Property="Background" Value="{StaticResource PurpleGradient}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="25" Width="50" Height="50">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect Color="#7F00FF" BlurRadius="15" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeonSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" Background="#25213b" CornerRadius="3" VerticalAlignment="Center" Margin="8,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{StaticResource PurpleGradient}" CornerRadius="3,0,0,3">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#E100FF" BlurRadius="5" ShadowDepth="0" Opacity="0.8"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#E100FF" BlurRadius="10" ShadowDepth="0"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- COLUMN 1: SIDEBAR -->
        <Border Background="#0d0a18" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="20,40,20,0">
                <!-- App Brand -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                    <TextBlock Text="|||" Foreground="{StaticResource PurpleGradient}" FontSize="24" FontWeight="Bold" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Sound Studio" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Feel the Difference" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>
                
                <!-- Menu Items -->
                <Border Background="#251b4d" CornerRadius="10" Padding="15,10" Margin="0,5">
                    <TextBlock Text="Sound Control" Foreground="White" FontWeight="SemiBold"/>
                </Border>
                <Border Padding="15,10" Margin="0,5">
                    <TextBlock Text="Equalizer" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <Border Padding="15,10" Margin="0,5">
                    <TextBlock Text="Audio Devices" Foreground="{StaticResource TextMuted}"/>
                </Border>
                <Border Padding="15,10" Margin="0,5">
                    <TextBlock Text="Settings" Foreground="{StaticResource TextMuted}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- COLUMN 2: CENTER PANEL -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Margin="10,20,10,20">
                <TextBlock Text="Sound Control" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Manage your audio experience" FontSize="14" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>

            <!-- YouTube Explorer Panel -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="10">
                <StackPanel Margin="20">
                    <TextBlock Text="Music Explorer (YouTube)" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="YoutubeUrlTextBox" Background="#0B0914" Foreground="White" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" Padding="10" VerticalContentAlignment="Center" FontSize="14"/>
                        <Button Grid.Column="1" Content="LOAD AUDIO" Style="{StaticResource HeaderBtn}" Margin="15,0,0,0" Click="LoadYoutubeButton_Click"/>
                    </Grid>
                    <TextBlock x:Name="YoutubeStatusText" Margin="0,10,0,0" Text="" Foreground="#E100FF" FontSize="12" FontStyle="Italic"/>
                </StackPanel>
            </Border>

            <!-- Output Volume Panel -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Margin="10">
                <StackPanel Margin="20">
                    <TextBlock Text="Output Volume" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,25"/>

                    <!-- Slider 1 -->
                    <Grid Margin="0,10,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Master Output" FontWeight="SemiBold"/>
                            <TextBlock Text="High Quality Audio" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1" Value="1" ValueChanged="VolumeSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="100%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <!-- Slider 2 -->
                    <Grid Margin="0,10,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Keypress Sound" FontWeight="SemiBold"/>
                            <TextBlock Text="Click Effect" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="80%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- COLUMN 3: RIGHT PANEL (NOW PLAYING) -->
        <Grid Grid.Column="2" Margin="10,30,30,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Now Playing Card -->
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,20">
                <StackPanel Margin="20">
                    <TextBlock Text="Now Playing" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <!-- Album Art Placeholder -->
                    <Border Height="180" CornerRadius="10" Background="{StaticResource PrimaryGradient}" Margin="0,0,0,20">
                        <TextBlock Text="AUDIO" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                    </Border>
                    
                    <!-- Track Info -->
                    <TextBlock x:Name="CurrentFileText" Text="click.wav" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="Sound Studio App" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                    
                    <!-- Controls -->
                    <Grid Margin="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="1" Content="&#xE100;" FontFamily="Segoe UI Symbol" Style="{StaticResource HeaderBtn}" Background="Transparent" Margin="0,0,15,0" Click="StopButton_Click"/>
                        <Button Grid.Column="2" Content="&#xE102;" FontFamily="Segoe UI Symbol" Style="{StaticResource PlayBtn}" Click="PlayButton_Click"/>
                        <Button Grid.Column="3" Content="&#xE142;" FontFamily="Segoe UI Symbol" Style="{StaticResource HeaderBtn}" Background="Transparent" Margin="15,0,0,0" Click="BrowseButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Visualizer Card -->
            <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
                <StackPanel Margin="20">
                    <TextBlock Text="Audio Active" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,20"/>
                    
                    <StackPanel x:Name="WaveformPanel" Orientation="Horizontal" HorizontalAlignment="Center" Height="80" Opacity="0.5">
                        <Rectangle Width="6" Height="20" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="40" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="25" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="60" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="30" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="70" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="45" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="55" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="20" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                        <Rectangle Width="6" Height="35" Fill="{StaticResource PurpleGradient}" Margin="3" RadiusX="3" RadiusY="3"/>
                    </StackPanel>
                    
                    <TextBlock x:Name="KeyDisplay" Text="READY" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
